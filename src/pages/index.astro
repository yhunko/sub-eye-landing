---
import MainLayout from "../layouts/MainLayout.astro";
import Landing from "../components/Landing.astro";

export const prerender = false;

const title = "SubEye – Free Subscription Tracker & Renewal Monitor";
const description =
  "Track all your subscriptions free with SubEye. Get instant visibility into upcoming renewals, spot forgotten charges, and never pay for a subscription you don't use. Free plan — no credit card needed.";
---

<MainLayout lang="en" title={title} description={description}>
  <Landing lang="en" />
</MainLayout>
