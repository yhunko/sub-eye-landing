---
import MainLayout from "../../layouts/MainLayout.astro";
import Landing from "../../components/Landing.astro";

export const prerender = false;

const title = "SubEye – Безкоштовний трекер підписок та контроль продовжень";
const description =
  "Безкоштовно відстежуйте всі підписки з SubEye. Бачте майбутні продовження, знаходьте забуті сервіси та не переплачуйте. Безкоштовний план — до 20 підписок, без картки.";
---

<MainLayout lang="ua" title={title} description={description}>
  <Landing lang="ua" />
</MainLayout>
