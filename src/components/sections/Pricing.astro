---
import type { Lang, LandingDict } from "../../i18n";
import { appUrls } from "../../lib/app-links";
import { getProPricingModel } from "../../lib/paddle-pricing";
import {
  fetchPlans,
  type PlanData,
  type PlanFeatureKey,
} from "../../lib/plans";
import SectionHeader from "../shared/SectionHeader.astro";
import Button from "../shared/Button.astro";
import Card from "../shared/Card.astro";
import Pill from "../shared/Pill.astro";

interface Props {
  lang: Lang;
  t: LandingDict;
}

const { lang, t } = Astro.props;
const pricingModel = await getProPricingModel({
  lang,
  request: Astro.request,
  fallbackPrice: t.pricing.pro.price,
  fallbackPlanName: t.pricing.pro.name,
});
const { plans, quotas } = await fetchPlans();
const plusCtaLabel = t.pricing.pro.cta.includes(t.pricing.pro.name)
  ? t.pricing.pro.cta.replaceAll(t.pricing.pro.name, pricingModel.planName)
  : t.pricing.pro.cta;

const freePlan = plans.find((plan) => plan.id === "free") ?? plans[0];
const plusPlan =
  plans.find((plan) => plan.id === "plus") ??
  plans.find((plan) => plan.id === "pro") ??
  plans.find((plan) => plan.id !== "free") ??
  plans[1] ??
  plans[0];

const FEATURE_LABELS: Record<Lang, Partial<Record<PlanFeatureKey, string>>> = {
  en: {
    subscriptions: "Subscription tracking",
    analytics: "Spending analytics",
    notifications: "Renewal notifications",
    notificationSchedule: "Custom notification schedule",
    telegramMessageTemplate: "Custom Telegram template",
    currency: "Multi-currency support",
    comparator: "Subscription comparator",
    aiInsights: "AI-powered insights",
  },
  ua: {
    subscriptions: "Трекінг підписок",
    analytics: "Аналітика витрат",
    notifications: "Нагадування про продовження",
    notificationSchedule: "Гнучкий графік сповіщень",
    telegramMessageTemplate: "Кастомний шаблон Telegram",
    currency: "Підтримка мультивалютності",
    comparator: "Порівняння підписок",
    aiInsights: "AI-інсайти",
  },
};

const getFeatureLabels = (
  plan: PlanData,
  excludeKeys?: Set<string>,
): string[] =>
  plan.features
    .filter((f) => f.included && !excludeKeys?.has(f.key))
    .map((f) => FEATURE_LABELS[lang][f.key as PlanFeatureKey])
    .filter((label): label is string => Boolean(label));

const formatSubscriptionsLimit = (value: number): string =>
  lang === "ua" ? `До ${value} підписок` : `Up to ${value} subscriptions`;

const formatCategoriesLimit = (value: number | null): string => {
  if (value === null) {
    return lang === "ua" ? "Безлімітні категорії" : "Unlimited categories";
  }

  return lang === "ua" ? `До ${value} категорій` : `Up to ${value} categories`;
};

const formatAiInsightsQuota = (value: number | null): string => {
  if (value === null) {
    return lang === "ua"
      ? "Безлімітні AI-інсайти / місяць"
      : "Unlimited AI insights / month";
  }

  return lang === "ua"
    ? `${value} AI-інсайтів / місяць`
    : `${value} AI insights / month`;
};

const formatComparatorQuota = (value: number | null): string => {
  if (value === null) {
    return lang === "ua"
      ? "Безлімітні порівняння / місяць"
      : "Unlimited comparisons / month";
  }

  return lang === "ua"
    ? `${value} порівнянь / місяць`
    : `${value} comparisons / month`;
};

const freeFeatures = getFeatureLabels(freePlan);
const plusFeatures =
  plusPlan.id === freePlan.id
    ? getFeatureLabels(plusPlan)
    : getFeatureLabels(
        plusPlan,
        new Set(freePlan.features.filter((f) => f.included).map((f) => f.key)),
      );
---

<script
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "SubEye",
    operatingSystem: "Web",
    applicationCategory: "FinanceApplication",
    url: lang === "ua" ? "https://www.subeye.cc/ua/" : "https://www.subeye.cc/",
    offers:
      pricingModel.rawAmount !== null
        ? [
            {
              "@type": "Offer",
              name: t.pricing.free.name,
              price: "0",
              priceCurrency: pricingModel.currencyCode,
            },
            {
              "@type": "Offer",
              name: pricingModel.planName,
              price: String(pricingModel.rawAmount),
              priceCurrency: pricingModel.currencyCode,
            },
          ]
        : {
            "@type": "Offer",
            name: t.pricing.free.name,
            price: "0",
            priceCurrency: lang === "ua" ? "UAH" : "USD",
          },
  })}
/>

<section
  id="pricing"
  data-price-source={pricingModel.source}
  class="border-border/60 scroll-mt-12 border-b bg-[radial-gradient(circle_at_top,rgba(59,130,246,0.32),transparent_55%)]"
>
  <div class="container space-y-10 py-12 sm:py-16 lg:py-20">
    <SectionHeader
      title={t.sections.pricingTitle}
      subtitle={t.sections.pricingSubtitle}
    />

    <div class="grid items-start gap-6 lg:grid-cols-2">
      <Card class="space-y-5 p-6 sm:p-7 lg:p-8">
        <div
          class="flex flex-col flex-wrap items-baseline justify-between gap-4"
        >
          <div class="space-y-1.5">
            <Pill>{t.pricing.free.badge}</Pill>
            <h3 class="text-lg font-semibold sm:text-xl">
              {t.pricing.free.name}
            </h3>
            <p class="text-muted-foreground max-w-md text-xs sm:text-sm">
              {t.pricing.free.description}
            </p>
          </div>
          <div class="self-end">
            <span class="text-2xl font-semibold sm:text-3xl"
              >{t.pricing.free.price}</span
            >
            <span class="text-muted-foreground text-xs"
              >{t.pricing.free.per}</span
            >
          </div>
        </div>

        <Button href={appUrls.billing} class="w-full">
          {t.pricing.free.cta}
        </Button>

        <div class="space-y-3 pt-1">
          <p
            class="text-muted-foreground text-xs font-medium tracking-[0.18em] uppercase"
          >
            {t.pricing.free.includesTitle}
          </p>
          <ul class="space-y-2 text-xs sm:text-sm">
            {
              freeFeatures.map((item) => (
                <li class="flex items-center gap-2">
                  <span class="inline-flex size-1.5 rounded-full bg-emerald-400 shadow-[0_0_0_4px_rgba(16,185,129,0.4)]" />
                  <span class="text-muted-foreground">{item}</span>
                </li>
              ))
            }
            <li class="flex items-center gap-2">
              <span class="inline-flex size-1.5 rounded-full bg-emerald-400 shadow-[0_0_0_4px_rgba(16,185,129,0.4)]" />
              <span class="text-muted-foreground">
                {formatSubscriptionsLimit(freePlan.limits.maxSubscriptions)}
              </span>
            </li>
            <li class="flex items-center gap-2">
              <span class="inline-flex size-1.5 rounded-full bg-emerald-400 shadow-[0_0_0_4px_rgba(16,185,129,0.4)]" />
              <span class="text-muted-foreground">
                {formatCategoriesLimit(freePlan.limits.maxCategories)}
              </span>
            </li>
            <li class="flex items-center gap-2">
              <span class="inline-flex size-1.5 rounded-full bg-emerald-400 shadow-[0_0_0_4px_rgba(16,185,129,0.4)]" />
              <span class="text-muted-foreground">
                {formatAiInsightsQuota(quotas.free.comparatorAiMonthly)}
              </span>
            </li>
            <li class="flex items-center gap-2">
              <span class="inline-flex size-1.5 rounded-full bg-emerald-400 shadow-[0_0_0_4px_rgba(16,185,129,0.4)]" />
              <span class="text-muted-foreground">
                {formatComparatorQuota(quotas.free.comparatorMonthly)}
              </span>
            </li>
          </ul>
        </div>
      </Card>

      <Card variant="primary" class="space-y-5 p-6 sm:p-7 lg:p-8">
        <div class="flex flex-col gap-4">
          <div class="space-y-1.5">
            <Pill>{t.pricing.pro.badge}</Pill>
            <h3 class="text-lg font-semibold sm:text-xl">
              {pricingModel.planName}
            </h3>
            <p class="text-muted-foreground max-w-md text-xs sm:text-sm">
              {t.pricing.pro.description}
            </p>
          </div>
          <div>
            <span class="text-2xl font-semibold sm:text-3xl"
              >{pricingModel.displayPrice}</span
            >
            <span class="text-muted-foreground text-xs"
              >{t.pricing.pro.per}</span
            >
            <p class="text-muted-foreground mt-1 text-[11px]">
              {t.pricing.pro.priceNote}
            </p>
          </div>
        </div>

        <Button href={appUrls.billing} class="w-full">
          {plusCtaLabel}
        </Button>

        <div class="space-y-3 pt-1">
          <p
            class="text-muted-foreground text-xs font-medium tracking-[0.18em] uppercase"
          >
            {t.pricing.pro.includesTitle}
          </p>
          <ul class="space-y-2 text-xs sm:text-sm">
            {
              plusFeatures.map((item) => (
                <li class="flex items-center gap-2">
                  <span class="inline-flex size-1.5 rounded-full bg-emerald-400 shadow-[0_0_0_4px_rgba(16,185,129,0.4)]" />
                  <span class="text-muted-foreground">{item}</span>
                </li>
              ))
            }
            <li class="flex items-center gap-2">
              <span class="inline-flex size-1.5 rounded-full bg-emerald-400 shadow-[0_0_0_4px_rgba(16,185,129,0.4)]" />
              <span class="text-muted-foreground">
                {formatSubscriptionsLimit(plusPlan.limits.maxSubscriptions)}
              </span>
            </li>
            <li class="flex items-center gap-2">
              <span class="inline-flex size-1.5 rounded-full bg-emerald-400 shadow-[0_0_0_4px_rgba(16,185,129,0.4)]" />
              <span class="text-muted-foreground">
                {formatCategoriesLimit(plusPlan.limits.maxCategories)}
              </span>
            </li>
            <li class="flex items-center gap-2">
              <span class="inline-flex size-1.5 rounded-full bg-emerald-400 shadow-[0_0_0_4px_rgba(16,185,129,0.4)]" />
              <span class="text-muted-foreground">
                {formatAiInsightsQuota(quotas.plus.comparatorAiMonthly)}
              </span>
            </li>
            <li class="flex items-center gap-2">
              <span class="inline-flex size-1.5 rounded-full bg-emerald-400 shadow-[0_0_0_4px_rgba(16,185,129,0.4)]" />
              <span class="text-muted-foreground">
                {formatComparatorQuota(quotas.plus.comparatorMonthly)}
              </span>
            </li>
          </ul>
        </div>
      </Card>
    </div>
  </div>
</section>
