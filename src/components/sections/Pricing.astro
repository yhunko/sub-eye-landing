---
import type { LandingDict } from "../../i18n";
import SectionHeader from "../shared/SectionHeader.astro";
import Button from "../shared/Button.astro";
import Card from "../shared/Card.astro";
import Pill from "../shared/Pill.astro";

interface Props {
  t: LandingDict;
}

const { t } = Astro.props;
---

<section
  id="pricing"
  class="border-border/60 scroll-mt-12 border-b bg-[radial-gradient(circle_at_top,rgba(59,130,246,0.32),transparent_55%)]"
>
  <div class="container space-y-10 py-12 sm:py-16 lg:py-20">
    <SectionHeader
      title={t.sections.pricingTitle}
      subtitle={t.sections.pricingSubtitle}
    />

    <div class="grid items-start gap-6 lg:grid-cols-2">
      <Card class="space-y-5 p-6 sm:p-7 lg:p-8">
        <div
          class="flex flex-col flex-wrap items-baseline justify-between gap-4"
        >
          <div class="space-y-1.5">
            <Pill>{t.pricing.free.badge}</Pill>
            <h3 class="text-lg font-semibold sm:text-xl">
              {t.pricing.free.name}
            </h3>
            <p class="text-muted-foreground max-w-md text-xs sm:text-sm">
              {t.pricing.free.description}
            </p>
          </div>
          <div class="self-end">
            <span class="text-2xl font-semibold sm:text-3xl"
              >{t.pricing.free.price}</span
            >
            <span class="text-muted-foreground text-xs"
              >{t.pricing.free.per}</span
            >
          </div>
        </div>

        <Button href="https://app.subeye.cc/auth/sign-up" class="w-full">
          {t.pricing.free.cta}
        </Button>

        <div class="space-y-3 pt-1">
          <p
            class="text-muted-foreground text-xs font-medium tracking-[0.18em] uppercase"
          >
            {t.pricing.free.includesTitle}
          </p>
          <ul class="space-y-2 text-xs sm:text-sm">
            {
              t.pricing.free.includes.map((item) => (
                <li class="flex items-center gap-2">
                  <span class="inline-flex size-1.5 rounded-full bg-emerald-400 shadow-[0_0_0_4px_rgba(16,185,129,0.4)]" />
                  <span class="text-muted-foreground">{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </Card>

      <Card variant="primary" class="space-y-5 p-6 sm:p-7 lg:p-8">
        <div class="flex flex-col gap-4">
          <div class="space-y-1.5">
            <Pill>{t.pricing.pro.badge}</Pill>
            <h3 class="text-lg font-semibold sm:text-xl">
              {t.pricing.pro.name}
            </h3>
            <p class="text-muted-foreground max-w-md text-xs sm:text-sm">
              {t.pricing.pro.description}
            </p>
          </div>
          <div>
            <span class="text-2xl font-semibold sm:text-3xl"
              >{t.pricing.pro.price}</span
            >
            <span class="text-muted-foreground text-xs"
              >{t.pricing.pro.per}</span
            >
            <p class="text-muted-foreground mt-1 text-[11px]">
              {t.pricing.pro.priceNote}
            </p>
          </div>
        </div>

        <Button href="https://app.subeye.cc/auth/sign-up" class="w-full">
          {t.pricing.pro.cta}
        </Button>

        <div class="space-y-3 pt-1">
          <p
            class="text-muted-foreground text-xs font-medium tracking-[0.18em] uppercase"
          >
            {t.pricing.pro.includesTitle}
          </p>
          <ul class="space-y-2 text-xs sm:text-sm">
            {
              t.pricing.pro.includes.map((item) => (
                <li class="flex items-center gap-2">
                  <span class="inline-flex size-1.5 rounded-full bg-emerald-400 shadow-[0_0_0_4px_rgba(16,185,129,0.4)]" />
                  <span class="text-muted-foreground">{item}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="border-border/60 space-y-2 border-t pt-4">
          <p
            class="text-muted-foreground text-xs font-medium tracking-[0.18em] uppercase"
          >
            {t.pricing.pro.localPricesTitle}
          </p>
          <ul class="space-y-1.5 text-xs sm:text-sm">
            {
              t.pricing.pro.localPrices.map(({ flag, label, price }) => (
                <li class="text-muted-foreground flex items-center justify-between gap-3">
                  <span>
                    {flag} {label}
                  </span>
                  <span class="text-foreground font-medium">{price}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </Card>
    </div>

    <p class="text-muted-foreground text-center text-xs">
      {t.pricing.sectionNote}
    </p>
  </div>
</section>
